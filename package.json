{
  "name": "boozer-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25", "npm": ">=11 <12" },
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run typecheck && npm run build:server && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:model": "vitest run --config vitest.model.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
