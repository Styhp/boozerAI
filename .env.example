# Copy this file to .env in Boozer AI's root folder and edit .env privately.
# .env is ignored by Git. Never put real credentials in this example file.
# Restart npm start / npm run dev after changing .env.
# Terminal-exported settings take precedence, including an empty value.

# Optional: enables the existing OpenAI comparison after preview + explicit send.
# Leave empty to keep cloud comparison unavailable.
# Use OPENAI_API_KEY exactly; never prefix a secret with VITE_.
OPENAI_API_KEY=

# This is currently the only supported .env setting.
# Ollama uses the fixed local connection; it needs no API key.
# GitHub, JEV, LangSmith, plugins and MCP are not connected by this file.
